{
  "version": 2,
  "functions": {
    "api/*.py": {
      "includeFiles": "src/**"
    },
    "main.py": {
      "includeFiles": "src/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health(.*)",
      "destination": "/api/index.py"
    }
  ]
}
